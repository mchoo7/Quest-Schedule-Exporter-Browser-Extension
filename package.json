{
	"name": "quest-schedule-exporter-browser-extension",
	"description": "Schedule exporting browser extension for uWaterloo Quest",
	"private": true,
	"version": "1.0.1",
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:chrome": "wxt -b chrome",
		"dev:edge": "wxt -b edge",
		"dev:firefox": "wxt -b firefox",
		"dev:safari": "wxt -b safari",
		"build": "pnpm build:chrome && pnpm build:edge && pnpm build:firefox && pnpm build:safari",
		"build:chrome": "wxt build -b chrome",
		"build:edge": "wxt build -b edge",
		"build:firefox": "wxt build -b firefox",
		"build:safari": "wxt build -b safari",
		"zip": "pnpm zip:chrome && pnpm zip:edge && pnpm zip:firefox && pnpm zip:safari",
		"zip:chrome": "wxt zip -b chrome",
		"zip:edge": "wxt zip -b edge",
		"zip:firefox": "wxt zip -b firefox",
		"zip:safari": "wxt zip -b safari",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"postinstall": "wxt prepare",
		"test": "pnpm test:unit && pnpm test:e2e",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest watch",
		"test:e2e": "pnpm exec playwright test",
		"test:e2e:watch": "pnpm exec playwright test --watch"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^4.1.11",
		"@wxt-dev/auto-icons": "^1.1.2",
		"@wxt-dev/module-svelte": "^2.0.5",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"wxt": "^0.21.4"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"tailwindcss": "^4.3.3"
	},
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=22.13"
	}
}
